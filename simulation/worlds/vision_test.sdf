<?xml version="1.0" ?>

<sdf version="1.9">

  <world name="vision_test">

    <!-- ========================================= -->
    <!-- PHYSICS                                   -->
    <!-- ========================================= -->

    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>


    <!-- ========================================= -->
    <!-- WORLD SETTINGS                            -->
    <!-- ========================================= -->

    <gravity>0 0 -9.8</gravity>

    <magnetic_field>
      6e-06 2.3e-05 -4.2e-05
    </magnetic_field>

    <atmosphere type="adiabatic"/>


    <spherical_coordinates>

      <surface_model>
        EARTH_WGS84
      </surface_model>

      <world_frame_orientation>
        ENU
      </world_frame_orientation>

      <latitude_deg>
        47.397971057728974
      </latitude_deg>

      <longitude_deg>
        8.546163739800146
      </longitude_deg>

      <elevation>
        0
      </elevation>

    </spherical_coordinates>


    <!-- ========================================= -->
    <!-- SUN                                       -->
    <!-- ========================================= -->

    <light
      type="directional"
      name="sun"
    >

      <cast_shadows>
        true
      </cast_shadows>

      <pose>
        0 0 20 0 0 0
      </pose>

      <diffuse>
        0.9 0.9 0.9 1
      </diffuse>

      <specular>
        0.2 0.2 0.2 1
      </specular>

      <direction>
        -0.5 0.1 -0.9
      </direction>

    </light>


    <!-- ========================================= -->
    <!-- GROUND                                    -->
    <!-- ========================================= -->

    <model name="ground_plane">

      <static>true</static>

      <link name="link">

        <collision name="collision">

          <geometry>

            <plane>

              <normal>
                0 0 1
              </normal>

              <size>
                100 100
              </size>

            </plane>

          </geometry>

        </collision>


        <visual name="visual">

          <geometry>

            <plane>

              <normal>
                0 0 1
              </normal>

              <size>
                100 100
              </size>

            </plane>

          </geometry>

          <material>

            <diffuse>
              0.22 0.22 0.22 1
            </diffuse>

          </material>

        </visual>

      </link>

    </model>


    <!-- ========================================= -->
    <!-- OBJECT A                                  -->
    <!-- Position: x=11 y=10                      -->
    <!-- ========================================= -->

    <model name="rack_alpha">

      <static>true</static>

      <pose>
        11 10 2 0 0 0
      </pose>

      <link name="link">

        <collision name="collision">

          <geometry>

            <box>

              <size>
                4 4 4
              </size>

            </box>

          </geometry>

        </collision>


        <visual name="visual">

          <geometry>

            <box>

              <size>
                4 4 4
              </size>

            </box>

          </geometry>

          <material>

            <diffuse>
              0.10 0.35 0.85 1
            </diffuse>

          </material>

        </visual>

      </link>

    </model>


    <!-- ========================================= -->
    <!-- OBJECT B                                  -->
    <!-- Position: x=12 y=-10                     -->
    <!-- ========================================= -->

    <model name="rack_beta">

      <static>true</static>

      <pose>
        12 -10 2 0 0 0
      </pose>

      <link name="link">

        <collision name="collision">

          <geometry>

            <box>

              <size>
                4 4 4
              </size>

            </box>

          </geometry>

        </collision>


        <visual name="visual">

          <geometry>

            <box>

              <size>
                4 4 4
              </size>

            </box>

          </geometry>

          <material>

            <diffuse>
              0.15 0.75 0.25 1
            </diffuse>

          </material>

        </visual>

      </link>

    </model>


    <!-- ========================================= -->
    <!-- OBJECT C                                  -->
    <!-- Position: x=19 y=0                       -->
    <!-- ========================================= -->

    <model name="machine_center">

      <static>true</static>

      <pose>
        19 0 2 0 0 0
      </pose>

      <link name="link">

        <collision name="collision">

          <geometry>

            <box>

              <size>
                4 4 4
              </size>

            </box>

          </geometry>

        </collision>


        <visual name="visual">

          <geometry>

            <box>

              <size>
                4 4 4
              </size>

            </box>

          </geometry>

          <material>

            <diffuse>
              0.20 0.70 0.75 1
            </diffuse>

          </material>

        </visual>

      </link>

    </model>


    <!-- ========================================= -->
    <!-- OBJECT D                                  -->
    <!-- TARGET COVER                             -->
    <!-- Position: x=25 y=10                      -->
    <!-- ========================================= -->

    <model name="rack_target_cover">

      <static>true</static>

      <pose>
        25 10 2 0 0 0
      </pose>

      <link name="link">

        <collision name="collision">

          <geometry>

            <box>

              <size>
                4.5 4.5 4
              </size>

            </box>

          </geometry>

        </collision>


        <visual name="visual">

          <geometry>

            <box>

              <size>
                4.5 4.5 4
              </size>

            </box>

          </geometry>

          <material>

            <diffuse>
              0.90 0.65 0.10 1
            </diffuse>

          </material>

        </visual>

      </link>

    </model>


    <!-- ========================================= -->
    <!-- OBJECT E                                  -->
    <!-- Position: x=26 y=-10                     -->
    <!-- ========================================= -->

    <model name="machine_delta">

      <static>true</static>

      <pose>
        26 -10 2 0 0 0
      </pose>

      <link name="link">

        <collision name="collision">

          <geometry>

            <box>

              <size>
                4 4 4
              </size>

            </box>

          </geometry>

        </collision>


        <visual name="visual">

          <geometry>

            <box>

              <size>
                4 4 4
              </size>

            </box>

          </geometry>

          <material>

            <diffuse>
              0.55 0.25 0.70 1
            </diffuse>

          </material>

        </visual>

      </link>

    </model>


    <!-- ========================================= -->
    <!-- OBJECT F                                  -->
    <!-- Position: x=19 y=17                      -->
    <!-- ========================================= -->

    <model name="crate_north">

      <static>true</static>

      <pose>
        19 17 1.75 0 0 0
      </pose>

      <link name="link">

        <collision name="collision">

          <geometry>

            <box>

              <size>
                4 4 3.5
              </size>

            </box>

          </geometry>

        </collision>


        <visual name="visual">

          <geometry>

            <box>

              <size>
                4 4 3.5
              </size>

            </box>

          </geometry>

          <material>

            <diffuse>
              0.60 0.35 0.15 1
            </diffuse>

          </material>

        </visual>

      </link>

    </model>


    <!-- ========================================= -->
    <!-- OBJECT G                                  -->
    <!-- Position: x=20 y=-18                     -->
    <!-- Cylinder gives different geometry        -->
    <!-- ========================================= -->

    <model name="tank_south">

      <static>true</static>

      <pose>
        20 -18 2 0 0 0
      </pose>

      <link name="link">

        <collision name="collision">

          <geometry>

            <cylinder>

              <radius>
                2
              </radius>

              <length>
                4
              </length>

            </cylinder>

          </geometry>

        </collision>


        <visual name="visual">

          <geometry>

            <cylinder>

              <radius>
                2
              </radius>

              <length>
                4
              </length>

            </cylinder>

          </geometry>

          <material>

            <diffuse>
              0.55 0.55 0.65 1
            </diffuse>

          </material>

        </visual>

      </link>

    </model>


    <!-- ========================================= -->
    <!-- RED SEARCH TARGET                         -->
    <!--                                           -->
    <!-- Visual only.                              -->
    <!-- LiDAR obstacle olarak algılamayacak.       -->
    <!--                                           -->
    <!-- Target cover'ın arkasında.                -->
    <!-- ========================================= -->

    <model name="red_search_target">

      <static>true</static>

      <pose>
        28.5 11.4 1.5 0 0 0
      </pose>

      <link name="link">

        <visual name="visual">

          <geometry>

            <box>

              <size>
                0.4 1.6 3
              </size>

            </box>

          </geometry>

          <material>

            <ambient>
              0.90 0.01 0.01 1
            </ambient>

            <diffuse>
              0.95 0.02 0.02 1
            </diffuse>

          </material>

        </visual>

      </link>

    </model>


  </world>

</sdf>